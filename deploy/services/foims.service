# FOIMS 生产环境 systemd 服务单元
#
# 使用方式：
#   1. DEB/RPM 包安装时由 scripts/build-pkgs.sh 自动安装到 /usr/lib/systemd/system/
#   2. 手动部署：sudo cp deploy/services/foims.service /etc/systemd/system/foims.service
#      sudo systemctl daemon-reload && sudo systemctl enable --now foims
#
# 路径约定（与 scripts/build-pkgs.sh 打包布局一致）：
#   二进制   /usr/bin/foims
#   静态资源 /usr/share/foims/web（nginx 直接托管，入口页与 assets/、icons/ 均在根下）
#   配置     /etc/foims/config.toml（生产唯一落点）
#   备份     /usr/share/foims/backups（定时/向导 pg_dump 的唯一落点）
# /opt/foims 已废弃（旧版静态资源目录，升级时由包脚本清理）。
# 本单元仅用于生产（开发可用 da-scripts/pak.sh 模拟生产部署）：CONFIG_PATHS 的
#   相对回退 ./config.toml 仅供开发环境直接运行二进制，与本单元无关。
#
# UDS 监听路径需三方一致：config.toml [server.listen] uds_path、
#   本单元的 RuntimeDirectory=foims、deploy/nginx/foims.conf 的 upstream。
#   生产推荐 /run/foims/api.sock（目录由 RuntimeDirectory 自动创建）。
# nginx 进程需能读写该 socket：config.toml uds_group 与下方 SupplementaryGroups
#   保持一致（Debian 系 nginx 以 www-data 运行，RHEL 系为 nginx）。
#   deb 安装时 postinst 自动检测实际用户，通过 drop-in 覆盖 SupplementaryGroups。

[Unit]
Description=FOIMS - Organization Infrastructure Management System
Documentation=man:foims(1)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=foims
Group=foims
# 允许 foims 进程将 UDS 的属组改为 nginx 运行组（与 uds_group 配置一致）
SupplementaryGroups=www-data
# 不设置 WorkingDirectory（systemd 默认 /）：生产配置只认 /etc/foims/config.toml，
# 服务不读相对路径资源（静态由 nginx 托管、日志与备份均为绝对路径），
# 留空可避免 ./config.toml 这类开发路径被意外命中
ExecStart=/usr/bin/foims
Restart=always
RestartSec=5s

# UDS 目录：systemd 启动时自动创建 /run/foims（属主 foims:foims），
# ProtectSystem=strict 下运行时目录仍可写，无需加入 ReadWritePaths
RuntimeDirectory=foims
RuntimeDirectoryMode=0755

# 允许绑定低端口 (80, 443)
AmbientCapabilities=CAP_NET_BIND_SERVICE

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# ReadWritePaths 逐项对应运行期写入点：/var/log/foims（日志）、/etc/foims
# （config.toml 回写与加密密钥）、/usr/share/foims/backups（数据库备份）。
# 静态资源目录（/usr/share/foims/web）刻意不列入：服务进程不应能改写自身资源。
ReadWritePaths=/var/log/foims /etc/foims /usr/share/foims/backups
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true

# 资源限制
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
