{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"root": true,
	"files": {
		"includes": [
			"frontend/src/styles/**",
			"!web-archive",
			"!foims-agent"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": "off",
			"complexity": {
				"noImportantStyles": "error"
			},
			"nursery": {
				"useLayeredStyles": "error"
			}
		}
	},
	"css": {
		"parser": {
			"allowWrongLineComments": true
		},
		"formatter": {
			"enabled": true,
			"indentStyle": "space",
			"indentWidth": 2
		}
	},
	"javascript": {
		"formatter": {
			"enabled": false
		}
	},
	"json": {
		"formatter": {
			"enabled": false
		}
	},
	"assist": {
		"enabled": false
	}
}
