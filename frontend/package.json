{
  "name": "foims-frontend",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "description": "FOIMS 前端（Vue 3 + Vite，MPA 三入口）",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "selfcheck:viz": "node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/visualization-geometry.selfcheck.ts && node --experimental-strip-types --import ./scripts/ts-resolve-hook.mjs scripts/visualization-viewmodel.selfcheck.ts"
  },
  "dependencies": {
    "@tanstack/vue-query": "latest",
    "pinia": "latest",
    "vue": "latest",
    "vue-i18n": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "latest",
    "typescript": "^6.0.3",
    "vite": "latest",
    "vue-tsc": "latest"
  }
}
