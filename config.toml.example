[database]
host = "localhost"
port = 5432
database = "ipma"
username = "username"
password = "password"
max_connections = 20
min_connections = 5
acquire_timeout_secs = 15
idle_timeout_secs = 60
max_lifetime_secs = 1800
query_timeout_secs = 30
slow_query_threshold_ms = 1000
health_check_interval_secs = 30

[server]
host = "0.0.0.0"
host_ipv6 = "::"
http_enabled = true
http_port = 80
https_enabled = true
https_port = 443
auto_https = true
http_version = "http2"
cert_type = "self_signed"
public_url = "localhost/"
# 页面无操作超时时间（分钟）：用户无操作超过此时间后强制重新登录
# 建议设置为 30-60 分钟，应大于 access_token_expiry
page_timeout = 30
cors_allowed_origins = []

[jwt]
secret = "451#Tl{+wpWLE$c}V3V{5d!m5!4R}N/>)p{1"
# Access Token 有效期：建议 5-15 分钟，短有效期减少被盗用风险
# 前端自动刷新间隔应设为此值的 50%（如 15min -> 7min）
access_token_expiry = "15m"
# Refresh Token 有效期：建议 7-30 天，用于获取新的 Access Token
refresh_token_expiry = "7d"

[init]
enabled = false

[i18n]
default_language = "zh"
supported_languages = [
    "zh",
    "en",
]

[rate_limit]
ip_limit = 1000
user_limit = 200
login_limit = 5
window_secs = 60
email_limit = 5
email_window_secs = 3600
enabled = true

[snmp]
timeout_secs = 5
retries = 3
lldp_timeout_secs = 30
mac_scan_timeout_secs = 10
