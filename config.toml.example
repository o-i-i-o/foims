[database]
host = "localhost"
port = 5432
database = "foims"
username = "username"
password = "password"
max_connections = 20
min_connections = 5
acquire_timeout_secs = 15
idle_timeout_secs = 60
max_lifetime_secs = 1800
query_timeout_secs = 30
health_check_interval_secs = 30

[server]
# 兼容性字段（保留用于公共 URL 解析，不再用于实际监听）
host = "127.0.0.1"
host_ipv6 = ""
public_url = "localhost/"
# 页面无操作超时时间（分钟）：用户无操作超过此时间后强制重新登录
# 建议设置为 30-60 分钟，应大于 access_token_expiry
page_timeout = 30
cors_allowed_origins = []

# 监听配置（UDS + h2c 模式）
# 架构说明：
# - axum 监听 Unix Domain Socket，使用 h2c (HTTP/2 cleartext) 协议
# - nginx 通过 proxy_http_version 2.0 以 h2c 反代到 axum（deploy/nginx/foims.conf）
# - 静态文件由 nginx 直接托管，axum 仅服务 API
# - 调试时手动启动 axum 即可，无需安装 systemd 服务
#   示例：sudo FOIMS_WEB_DIR=/path/to/foims/web ./target/release/foims
# - nginx 与 axum 通过 UDS + h2c 通信，多路复用 + keepalive 性能优于 HTTP/1.1
[server.listen]
# UDS socket 文件路径，需与 nginx upstream 配置一致
# 调试：/tmp/foims-dev.sock（避免权限问题）
# 生产：/run/foims/api.sock（systemd RuntimeDirectory 管理）
uds_path = "/tmp/foims-dev.sock"
# UDS socket 属组（须为反代 worker 进程的属组；Debian/Ubuntu nginx 为 www-data）
uds_group = "www-data"
# 是否由 axum 托管静态文件
# - false（推荐）：静态文件由 nginx 直接服务，axum 仅 API
# - true：axum 同时托管静态文件和 API（不推荐，与 nginx 重复）
# - axum托管静态文件仅供开发测试，功能可能存在异常或缺失，生产环境请确保nginx托管
serve_static = false

[jwt]
# 请替换为随机生成的 32 字符以上密钥（含大小写字母、数字、特殊字符）
# 可使用 openssl rand -base64 48 生成
secret = "CHANGE_ME_TO_RANDOM_32_PLUS_CHARS"
# Access Token 有效期：建议 5-15 分钟，短有效期减少被盗用风险
# 前端自动刷新间隔应设为此值的 50%（如 15min -> 7min）
access_token_expiry = "15m"
# Refresh Token 有效期：建议 7-30 天，用于获取新的 Access Token
refresh_token_expiry = "7d"

[init]
enabled = false

[i18n]
# 控制台日志语言（缺省 "en"），取值须属于 supported_languages
log_language = "en"
supported_languages = [
    "zh",
    "en",
]
# 日志文件输出语言（可选，每个语言一个独立文件；缺省跟随 log_language，
# 取值须为 supported_languages 的子集）
#logfiles_i18n_out = ["zh", "en"]

[rate_limit]
ip_limit = 1000
user_limit = 200
login_limit = 5
window_secs = 60
email_limit = 5
email_window_secs = 3600
enabled = true

[snmp]
timeout_secs = 5
retries = 3
lldp_timeout_secs = 30
mac_scan_timeout_secs = 10
