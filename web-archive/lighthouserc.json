{
  "ci": {
    "collect": {
      "startServerCommand": "python3 -m http.server 4173 --directory .",
      "url": [
        "http://localhost:4173/static/index.html",
        "http://localhost:4173/static/init_index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "errors-in-console": "off"
      }
    }
  }
}
